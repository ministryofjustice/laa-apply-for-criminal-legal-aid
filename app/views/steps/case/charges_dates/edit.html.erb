<% title t('.page_title') %>
<% step_header %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= render partial: 'shared/flash_banner' %>

    <%= govuk_error_summary(@form_object) %>

    <h1 class="govuk-heading-xl"><%=t '.heading' %></h1>

    <% offence_date_count = Array(@form_object&.offence_dates).length %>

    <%= step_form @form_object, data: { module: 'multi-action-form' } do |f| %>

      <%= f.govuk_fieldset(
            legend: lambda do
              tag.legend(
                safe_join([tag.strong(t('.offence_label')), ' ', @form_object.record.offence_name]),
                class: 'govuk-fieldset__legend govuk-fieldset__legend--m govuk-!-font-weight-regular'
              )
            end
          ) do %>
        <div class="moj-add-another">
          <div class="moj-add-another__items">
            <%= f.fields_for :offence_dates do |od| %>

              <% index = od.index + 1 %>

              <div class="moj-add-another__item">
                <div class="moj-add-another__item-container">
                  <div class="moj-add-another__item-row">
                    <%= od.govuk_fieldset legend: { text: t('.offence_legend', count: offence_date_count, index: index), class: 'moj-add-another__item-title' }, id: "offence_#{index}", class: 'moj-add-another__fieldset' do %>
                      <%= od.date_input :date_from, legend: { text: t('.date_from_label'), size: 's' } %>
                      <%= od.date_input :date_to, legend: { text: t('.date_to_label'), size: 's' } %>
                    <% end %>
                  </div>

                  <div class="moj-add-another__remove-button-container">
                    <%= od.button t('.remove_button', index:), type: :submit, value: '1', name: od.field_name(:_destroy, index: od.id),
                                  class: %w[govuk-button govuk-button--secondary moj-add-another__remove-button govuk-!-margin-bottom-8],
                                  data: { module: 'govuk-button' } if @form_object.show_destroy? %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%= govuk_inset_text(text: t('.inset')) %>

      <div class="moj-add-another__add-button-container">
        <%= f.button t('.add_button'), type: :submit, name: :add_offence_date,
                     class: %w[govuk-button govuk-button--secondary moj-add-another__add-button govuk-!-margin-bottom-8],
                     data: { module: 'govuk-button' } %>
      </div>

      <%= f.continue_button %>
    <% end %>
  </div>
</div>
