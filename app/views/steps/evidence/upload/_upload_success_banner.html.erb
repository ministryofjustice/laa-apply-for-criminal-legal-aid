<%# Populated, shown and focused by dropzone-cfg.js once a batch of uploads completes %>
<div class="govuk-notification-banner govuk-notification-banner--success" role="alert" tabindex="-1"
     aria-labelledby="upload-success-banner-title" id="upload-success-banner" hidden>
  <div class="govuk-notification-banner__header">
    <h2 class="govuk-notification-banner__title" id="upload-success-banner-title">
      <%= t(:title, scope: 'flash.success') %>
    </h2>
  </div>
  <div class="govuk-notification-banner__content"></div>
</div>
