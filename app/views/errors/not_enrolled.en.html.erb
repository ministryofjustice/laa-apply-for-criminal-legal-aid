<% title t('errors.not_enrolled') %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l"><%= t('errors.not_enrolled') %></h1>
    <p class="govuk-body"><%= t('errors.not_enrolled_subheading') %></p>

    <h2 class="govuk-heading-s"><%= t('helpers.contact.telephone') %></h2>
    <p class="govuk-body"><%= Settings.case_enquiries_tel %>, <%= t('helpers.contact.extension_option_three') %></p>
    <p class="govuk-body"><%= t('helpers.contact.opening_hours') %></p>
    <p class="govuk-body"><%= govuk_link_to(t('helpers.contact.call_charges'), Settings.call_charges_url) %></p>
    <h2 class="govuk-heading-s"><%= t('helpers.contact.online') %></h2>
    <p class="govuk-body">
      <%= t(
            'helpers.contact.non_urgent_enquiries_html',
            URL: govuk_link_to(
              t('helpers.contact.technical_fault_link'), Settings.technical_fault_reporting_url,
              new_tab: t('helpers.contact.opens_in_new_tab')
            )
          ) %>
    </p>
    <h2 class="govuk-heading-s"><%= t('helpers.contact.webchat') %></h2>
    <p class="govuk-body"><%= govuk_link_to(t('helpers.contact.webchat_adviser'), Settings.laa_contact_url) %></p>
  </div>
</div>
